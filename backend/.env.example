# Copy this file to .env and adjust values before running in production.

# Set to "production" when deploying for real. This enables fail-fast startup checks
# (refuses to start with a placeholder JWT_SECRET or CORS_ORIGINS=*) — see SECURITY.md.
# Leave unset/"development" for local dev; those checks are skipped so you can get
# started quickly without generating real secrets yet.
NODE_ENV=development

PORT=4000

# Comma-separated list of allowed origins for CORS + Socket.io.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=*

# Use a long, random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Access tokens are short-lived; refresh tokens (rotated on each use) keep the
# session alive without re-entering a password. See routes/auth.js.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Postgres connection string. A free Neon (https://neon.tech) database works great and
# is the recommended option — it's what keeps your data (and uploaded images) intact
# across every redeploy, instead of resetting like a local SQLite file on ephemeral
# hosting (Vercel/Render/etc. wipe local disk on every deploy/cold start).
#
# How to get one from Neon:
#   1. Sign up at https://neon.tech (free tier is enough for small/medium apps)
#   2. Create a project -> it gives you a connection string immediately
#   3. Copy the "pooled connection" string (recommended for serverless/many-connections)
#      It looks like: postgres://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#   4. Paste it below as DATABASE_URL
#
# Local development without Neon: point this at any local Postgres instead, e.g.
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/support_dev
DATABASE_URL=

# Set to "true" to also serve the customer/admin static PWAs from this same server
# (e.g. at /app and /admin) instead of hosting them on a separate static host/CDN.
SERVE_FRONTENDS=false

# --- TURN server (for WebRTC calls to work behind strict NATs/firewalls) ---
# STUN alone (used by default) is enough for most home/mobile networks, but some
# corporate networks block direct peer-to-peer connections entirely — TURN relays
# the media through a server instead. Leave blank to skip TURN (STUN-only).
#
# Option A — self-hosted (see docker-compose.yml's `turn` service + turnserver.conf):
#   TURN_URL=turn:your-server-ip:3478
#   TURN_SECRET=<same value as static-auth-secret in turnserver.conf>
#
# Option B — managed TURN provider (Twilio, Xirsys, Cloudflare Calls, Metered, etc.)
#   follow their docs for the URL + secret format they expect.
TURN_URL=
TURN_SECRET=
TURN_CREDENTIAL_TTL=3600

# --- Web Push (real browser notifications) ---
# Generate a keypair once with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys(),null,2))"
# Push notifications are silently disabled if these are left blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Social login (Google / Facebook / LINE) ---
# Recommended: configure this from Admin > Settings > "Social Login" instead of here —
# it saves to the database, takes effect immediately with no redeploy, and the callback
# URL to register with each provider is computed and shown to you automatically there.
# Full walkthrough (creating each provider's app, etc.) is in SOCIAL_LOGIN_SETUP.md.
#
# The .env values below are only a fallback for servers that were already configured
# this way before the Admin UI existed — the database always wins if both are set.
# Any provider left unconfigured just shows as disabled; the rest of the app is unaffected.
#
# Where the browser gets sent back to after a social login finishes (success or error).
# Also settable from Admin > Settings > "Social Login" as "URL หน้าเว็บลูกค้า".
FRONTEND_URL=http://localhost:5500/customer/index.html

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Developers -> your app -> Facebook Login -> Settings
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# LINE Developers Console -> Provider -> Channel (LINE Login)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
